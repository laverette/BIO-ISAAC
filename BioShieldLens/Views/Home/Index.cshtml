@{
    ViewData["Title"] = "Dashboard";
    var critical = ViewBag.Critical as List<Vulnerability> ?? new List<Vulnerability>();
    var monitor = ViewBag.Monitor as List<Vulnerability> ?? new List<Vulnerability>();
    var lowPriority = ViewBag.LowPriority as List<Vulnerability> ?? new List<Vulnerability>();
    var allVulnerabilities = ViewBag.AllVulnerabilities as List<Vulnerability> ?? new List<Vulnerability>();
    var stats = ViewBag.Stats as Dictionary<string, int> ?? new Dictionary<string, int>();
    var trends = ViewBag.Trends as List<Trend> ?? new List<Trend>();
    // Sector distribution will be serialized directly in the script
    var intelNotes = ViewBag.IntelNotes as string;
}

<div class="row">
    <div class="col-12 hero-section">
        <h1>BioShield Lens</h1>
        <p class="lead">AI-Powered Biological System Vulnerability Analysis</p>
    </div>
</div>

<!-- Auto-Refresh Status Bar -->
<div class="row">
    <div class="col-12">
        <div class="refresh-status-bar">
            <div class="refresh-info">
                <i class="bi bi-arrow-clockwise"></i>
                <span id="lastUpdated">Last updated: Just now</span>
            </div>
            <div class="refresh-controls">
                <span id="refreshCountdown" class="me-3">Auto-refresh in: <strong>5:00</strong></span>
                <button id="refreshNowBtn" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-clockwise"></i> Refresh Now
                </button>
                <button id="toggleAutoRefresh" class="btn btn-sm btn-outline-secondary ms-2">
                    <i class="bi bi-pause-fill"></i> <span id="autoRefreshText">Pause</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Welcome Introduction -->
<div class="row mt-4">
    <div class="col-12">
        <div class="welcome-card">
            <h2>Welcome to BioShield Lens</h2>
            <p class="intro-text">
                BioShield Lens helps you monitor and analyze cybersecurity vulnerabilities that could impact biological systems, 
                healthcare infrastructure, and life sciences organizations. Our AI-powered platform automatically classifies 
                vulnerabilities from the National Vulnerability Database (NVD) and prioritizes them based on their potential 
                impact on biological and human systems.
            </p>
            <div class="quick-start">
                <h3>Quick Start Guide</h3>
                <div class="steps">
                    <div class="step">
                        <span class="step-number">1</span>
                        <div class="step-content">
                            <strong>Import Data</strong>
                            <p>Scroll down to "Data Management" and click "Import from NVD API" to fetch real vulnerability data</p>
                        </div>
                    </div>
                    <div class="step">
                        <span class="step-number">2</span>
                        <div class="step-content">
                            <strong>Review Dashboard</strong>
                            <p>Check the statistics cards and charts to understand your vulnerability landscape</p>
                        </div>
                    </div>
                    <div class="step">
                        <span class="step-number">3</span>
                        <div class="step-content">
                            <strong>Take Action</strong>
                            <p>Click "View" on any vulnerability to see detailed analysis and AI-generated intelligence notes</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Export Buttons Row -->
<div class="row mt-4">
    <div class="col-12">
        <div class="d-flex justify-content-end gap-2 mb-3 flex-wrap">
            <a href="/export/csv" class="btn btn-outline-success export-btn" title="Export all data to Excel/CSV">
                <i class="bi bi-file-earmark-spreadsheet"></i> Export to Excel
            </a>
            <a href="/export/pdf" class="btn btn-outline-danger export-btn" title="Generate PDF Report">
                <i class="bi bi-file-earmark-pdf"></i> Export to PDF
            </a>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mt-4">
    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card text-white bg-danger stat-card">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h5 class="card-title">Critical</h5>
                </div>
                <div class="stat-number">@stats.GetValueOrDefault("Critical to Act Now", 0)</div>
                <p class="stat-description">Immediate action required</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card text-white bg-warning stat-card">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="bi bi-eye-fill"></i>
                    <h5 class="card-title">Monitor</h5>
                </div>
                <div class="stat-number">@stats.GetValueOrDefault("Monitor", 0)</div>
                <p class="stat-description">Requires monitoring</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card text-white bg-info stat-card">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="bi bi-info-circle-fill"></i>
                    <h5 class="card-title">Low Priority</h5>
                </div>
                <div class="stat-number">@stats.GetValueOrDefault("Low Priority", 0)</div>
                <p class="stat-description">Low impact items</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-4">
        <div class="card text-white bg-secondary stat-card">
            <div class="card-body">
                <div class="stat-icon">
                    <i class="bi bi-list-check"></i>
                    <h5 class="card-title">Total</h5>
                </div>
                <div class="stat-number">@stats.GetValueOrDefault("Total", 0)</div>
                <p class="stat-description">All vulnerabilities</p>
            </div>
        </div>
    </div>
</div>

<!-- Intel Notes -->
@if (!string.IsNullOrEmpty(intelNotes))
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5><i class="bi bi-lightbulb"></i> Intelligence Summary</h5>
                </div>
                <div class="card-body">
                    @Html.Raw(intelNotes)
                </div>
            </div>
        </div>
    </div>
}

<!-- Timeline Chart -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-graph-up"></i> Vulnerability Discovery Timeline</h5>
            </div>
            <div class="card-body" style="min-height: 300px; position: relative;">
                <canvas id="timelineChart"></canvas>
                <div id="timelineNoData" style="display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: var(--color-text-secondary);">
                    <i class="bi bi-info-circle" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <p>No vulnerability data available for timeline</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Vulnerability Distribution</h5>
            </div>
            <div class="card-body">
                <canvas id="vulnerabilityChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Trends by Sector</h5>
            </div>
            <div class="card-body">
                <canvas id="trendsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Import Data Section -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>Data Management</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Vulnerability" asp-action="Import" method="post">
                    <div class="row">
                        <div class="col-md-4">
                            <label for="count" class="form-label">Number of vulnerabilities</label>
                            <input type="number" class="form-control" id="count" name="count" value="50" min="1" max="2000" />
                        </div>
                        <div class="col-md-4">
                            <label for="keyword" class="form-label">Keyword filter (optional)</label>
                            <input type="text" class="form-control" id="keyword" name="keyword" placeholder="e.g., medical, hospital" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-download"></i> Import from NVD API
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Critical Vulnerabilities -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5><i class="bi bi-exclamation-triangle"></i> Critical to Act Now</h5>
            </div>
            <div class="card-body">
                @if (critical.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>CVE ID</th>
                                    <th>Description</th>
                                    <th>Bio Impact</th>
                                    <th>Human Impact</th>
                                    <th>Sector</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vuln in critical.Take(10))
                                {
                                <tr>
                                    <td><strong class="mobile-cve">@vuln.CveId</strong></td>
                                    <td class="description-cell">@(vuln.Description.Length > 100 ? vuln.Description.Substring(0, 100) + "..." : vuln.Description)</td>
                                    <td><span class="badge bg-danger">@(vuln.BioImpactScore?.ToString("F1") ?? "N/A")</span></td>
                                    <td><span class="badge bg-danger">@(vuln.HumanImpactScore?.ToString("F1") ?? "N/A")</span></td>
                                    <td class="sector-cell">@(vuln.AffectedSector ?? "Unknown")</td>
                                    <td class="date-cell">@(vuln.DateDiscovered?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    <td>
                                        <a asp-controller="Vulnerability" asp-action="Details" asp-route-id="@vuln.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (critical.Count > 10)
                    {
                        <a asp-controller="Vulnerability" asp-action="Index" asp-route-priority="Critical to Act Now" class="btn btn-outline-danger">View All @critical.Count Critical Vulnerabilities</a>
                    }
                }
                else
                {
                    <p class="text-muted">No critical vulnerabilities at this time.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Monitor Vulnerabilities -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h5><i class="bi bi-eye"></i> Monitor</h5>
            </div>
            <div class="card-body">
                @if (monitor.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>CVE ID</th>
                                    <th>Description</th>
                                    <th>Bio Impact</th>
                                    <th>Sector</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vuln in monitor.Take(5))
                                {
                                    <tr>
                                        <td><strong>@vuln.CveId</strong></td>
                                        <td>@(vuln.Description.Length > 80 ? vuln.Description.Substring(0, 80) + "..." : vuln.Description)</td>
                                        <td><span class="badge bg-warning">@(vuln.BioImpactScore?.ToString("F1") ?? "N/A")</span></td>
                                        <td>@(vuln.AffectedSector ?? "Unknown")</td>
                                        <td>@(vuln.DateDiscovered?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>
                                            <a asp-controller="Vulnerability" asp-action="Details" asp-route-id="@vuln.Id" class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (monitor.Count > 5)
                    {
                        <a asp-controller="Vulnerability" asp-action="Index" asp-route-priority="Monitor" class="btn btn-outline-warning">View All @monitor.Count Monitor Items</a>
                    }
                }
                else
                {
                    <p class="text-muted">No vulnerabilities to monitor at this time.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart instances storage
        let timelineChart = null;
        let vulnChart = null;
        let trendsChart = null;
        
        // Function to get theme colors
        function getThemeColors() {
            const isDarkMode = document.documentElement.getAttribute('data-theme') === 'dark';
            return {
                isDark: isDarkMode,
                text: isDarkMode ? '#FFFFFF' : '#1D1D1F',
                grid: isDarkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)',
                tooltipBg: isDarkMode ? 'rgba(255, 255, 255, 0.9)' : 'rgba(0, 0, 0, 0.8)',
                tooltipText: isDarkMode ? '#000000' : '#FFFFFF'
            };
        }
        
        // Function to update chart colors
        function updateChartColors() {
            const colors = getThemeColors();
            
            // Update timeline chart
            if (timelineChart) {
                timelineChart.options.plugins.legend.labels.color = colors.text;
                timelineChart.options.plugins.tooltip.backgroundColor = colors.tooltipBg;
                timelineChart.options.plugins.tooltip.titleColor = colors.tooltipText;
                timelineChart.options.plugins.tooltip.bodyColor = colors.tooltipText;
                timelineChart.options.scales.y.ticks.color = colors.text;
                timelineChart.options.scales.y.grid.color = colors.grid;
                timelineChart.options.scales.x.ticks.color = colors.text;
                timelineChart.options.scales.x.grid.color = colors.grid;
                timelineChart.update();
            }
            
            // Update vulnerability distribution chart
            if (vulnChart) {
                vulnChart.options.plugins.legend.labels.color = colors.text;
                vulnChart.options.plugins.tooltip.backgroundColor = colors.tooltipBg;
                vulnChart.options.plugins.tooltip.titleColor = colors.tooltipText;
                vulnChart.options.plugins.tooltip.bodyColor = colors.tooltipText;
                vulnChart.update();
            }
            
            // Update trends chart
            if (trendsChart) {
                trendsChart.options.plugins.tooltip.backgroundColor = colors.tooltipBg;
                trendsChart.options.plugins.tooltip.titleColor = colors.tooltipText;
                trendsChart.options.plugins.tooltip.bodyColor = colors.tooltipText;
                trendsChart.options.scales.y.ticks.color = colors.text;
                trendsChart.options.scales.y.grid.color = colors.grid;
                trendsChart.options.scales.x.ticks.color = colors.text;
                trendsChart.options.scales.x.grid.color = colors.grid;
                trendsChart.update();
            }
        }
        
        // Listen for theme changes via MutationObserver
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
                    updateChartColors();
                }
            });
        });
        observer.observe(document.documentElement, { attributes: true });
        
        // Also listen for dark mode button clicks (for immediate update)
        const darkModeButton = document.getElementById('darkModeToggle');
        if (darkModeButton) {
            darkModeButton.addEventListener('click', function() {
                // Small delay to ensure theme attribute is updated first
                setTimeout(updateChartColors, 100);
            });
        }
        
        // Vulnerability Timeline Chart
        const timelineCtx = document.getElementById('timelineChart').getContext('2d');
        
        // Prepare timeline data - group by date
        // Use all vulnerabilities, prefer DateDiscovered, fallback to CreatedAt
        const allVulns = @Html.Raw(Json.Serialize(allVulnerabilities
            .Where(v => v.DateDiscovered.HasValue || v.CreatedAt != default(DateTime))
            .Select(v => new { 
                Date = (v.DateDiscovered ?? v.CreatedAt).ToString("yyyy-MM-dd"), 
                Urgency = v.UrgencyLevel ?? "Unknown"
            })));
        
        console.log('Total vulnerabilities:', @allVulnerabilities.Count);
        console.log('Timeline data array:', allVulns);
        console.log('Is array?', Array.isArray(allVulns));
        
        // Group by date and count
        const dateGroups = {};
        const criticalByDate = {};
        const monitorByDate = {};
        const lowByDate = {};
        
        if (Array.isArray(allVulns) && allVulns.length > 0) {
            allVulns.forEach(v => {
                // JSON serialization uses camelCase, so property is 'date' not 'Date'
                const date = v.date || v.Date;
                const urgency = v.urgency || v.Urgency;
                
                if (!v || !date) {
                    console.log('Skipping invalid entry:', v);
                    return;
                }
                
                dateGroups[date] = (dateGroups[date] || 0) + 1;
                
                if (urgency === 'Critical to Act Now') {
                    criticalByDate[date] = (criticalByDate[date] || 0) + 1;
                } else if (urgency === 'Monitor') {
                    monitorByDate[date] = (monitorByDate[date] || 0) + 1;
                } else {
                    lowByDate[date] = (lowByDate[date] || 0) + 1;
                }
            });
        } else {
            console.log('No vulnerabilities found or data is not an array');
        }
        
        const sortedDates = Object.keys(dateGroups).sort();
        console.log('Date groups:', dateGroups);
        console.log('Sorted dates:', sortedDates);
        console.log('Critical by date:', criticalByDate);
        console.log('Monitor by date:', monitorByDate);
        console.log('Low by date:', lowByDate);
        
        // Only create chart if we have data
        if (sortedDates.length > 0) {
            const colors = getThemeColors();
            timelineChart = new Chart(timelineCtx, {
                type: 'line',
                data: {
                    labels: sortedDates,
                    datasets: [
                        {
                            label: 'Critical',
                            data: sortedDates.map(d => criticalByDate[d] || 0),
                            borderColor: '#FF3B30',
                            backgroundColor: 'rgba(255, 59, 48, 0.1)',
                            tension: 0.4,
                            fill: true
                        },
                        {
                            label: 'Monitor',
                            data: sortedDates.map(d => monitorByDate[d] || 0),
                            borderColor: '#FF9500',
                            backgroundColor: 'rgba(255, 149, 0, 0.1)',
                            tension: 0.4,
                            fill: true
                        },
                        {
                            label: 'Low Priority',
                            data: sortedDates.map(d => lowByDate[d] || 0),
                            borderColor: '#5AC8FA',
                            backgroundColor: 'rgba(90, 200, 250, 0.1)',
                            tension: 0.4,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                color: colors.text
                            }
                        },
                        tooltip: {
                            backgroundColor: colors.tooltipBg,
                            titleColor: colors.tooltipText,
                            bodyColor: colors.tooltipText,
                            padding: 12,
                            titleFont: { size: 14 },
                            bodyFont: { size: 13 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                stepSize: 1,
                                color: colors.text
                            },
                            grid: {
                                color: colors.grid
                            }
                        },
                        x: {
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45,
                                color: colors.text
                            },
                            grid: {
                                color: colors.grid
                            }
                        }
                    }
                }
            });
        } else {
            // Show message if no data
            document.getElementById('timelineChart').style.display = 'none';
            document.getElementById('timelineNoData').style.display = 'block';
        }

        // Vulnerability Distribution Chart
        const vulnCtx = document.getElementById('vulnerabilityChart').getContext('2d');
        const colors2 = getThemeColors();
        vulnChart = new Chart(vulnCtx, {
            type: 'doughnut',
            data: {
                labels: ['Critical to Act Now', 'Monitor', 'Low Priority'],
                datasets: [{
                    data: [
                        @stats.GetValueOrDefault("Critical to Act Now", 0),
                        @stats.GetValueOrDefault("Monitor", 0),
                        @stats.GetValueOrDefault("Low Priority", 0)
                    ],
                    backgroundColor: ['#FF3B30', '#FF9500', '#5AC8FA']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: colors2.text
                        }
                    },
                    tooltip: {
                        backgroundColor: colors2.tooltipBg,
                        titleColor: colors2.tooltipText,
                        bodyColor: colors2.tooltipText,
                        padding: 12,
                        titleFont: { size: 14 },
                        bodyFont: { size: 13 }
                    }
                }
            }
        });

        // Trends by Sector Chart - Show vulnerability counts by sector
        const trendsCtx = document.getElementById('trendsChart').getContext('2d');
        
        // Get sector data from server
        const allVulnsForSector = @Html.Raw(Json.Serialize(allVulnerabilities
            .Where(v => !string.IsNullOrEmpty(v.AffectedSector))
            .Select(v => new { Sector = v.AffectedSector })));
        
        // Calculate sector distribution
        const sectorCounts = {};
        if (Array.isArray(allVulnsForSector)) {
            allVulnsForSector.forEach(v => {
                const sector = v.sector || v.Sector;
                if (sector) {
                    sectorCounts[sector] = (sectorCounts[sector] || 0) + 1;
                }
            });
        }
        
        // Convert to arrays and sort by count (descending)
        const sectors = Object.keys(sectorCounts);
        const counts = sectors.map(s => sectorCounts[s]);
        
        // Sort by count (descending) and take top 10
        const sortedPairs = sectors.map((s, i) => ({ sector: s, count: counts[i] }))
            .sort((a, b) => b.count - a.count)
            .slice(0, 10);
        
        const topSectors = sortedPairs.map(p => p.sector);
        const topCounts = sortedPairs.map(p => p.count);
        
        console.log('Sector distribution:', sectorCounts);
        console.log('Top sectors:', topSectors);
        console.log('Top counts:', topCounts);
        
        if (topSectors.length > 0) {
            const colors3 = getThemeColors();
            trendsChart = new Chart(trendsCtx, {
                type: 'bar',
                data: {
                    labels: topSectors,
                    datasets: [{
                        label: 'Vulnerabilities',
                        data: topCounts,
                        backgroundColor: '#007AFF',
                        borderColor: '#0051D5',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: colors3.tooltipBg,
                            titleColor: colors3.tooltipText,
                            bodyColor: colors3.tooltipText,
                            padding: 12,
                            titleFont: { size: 14 },
                            bodyFont: { size: 13 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                stepSize: 1,
                                color: colors3.text
                            },
                            grid: {
                                color: colors3.grid
                            }
                        },
                        x: {
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45,
                                color: colors3.text
                            },
                            grid: {
                                color: colors3.grid
                            }
                        }
                    }
                }
            });
        } else {
            // Show message if no data
            trendsCtx.fillStyle = '#666';
            trendsCtx.font = '16px Arial';
            trendsCtx.textAlign = 'center';
            trendsCtx.fillText('No sector data available', trendsCtx.canvas.width / 2, trendsCtx.canvas.height / 2);
        }
    </script>
}



